type Query {
    accounts: [BankAccount!]!
    accountById(id: String!): BankAccount
    customers: [Customer!]!
}

type Mutation {
    addAccount(bankAccountDTO: BankAccountRequestDTO!): BankAccountResponseDTO!
    updateAccount(id: String!, bankAccountDTO: BankAccountRequestDTO!): BankAccountResponseDTO!
    deleteAccount(id: String!): Boolean!
}

type Customer {
    id: ID!
    name: String!
    accounts: [BankAccount!]!
}

type BankAccount {
    id: String!
    createdAt: String
    balance: Float
    currency: String
    type: AccountType
}

type BankAccountResponseDTO {
    id: String!
    createdAt: String
    balance: Float
    currency: String
    type: AccountType
}

input BankAccountRequestDTO {
    balance: Float
    currency: String
    type: AccountType
}

enum AccountType {
    CURRENT_ACCOUNT
    SAVING_ACCOUNT
}
